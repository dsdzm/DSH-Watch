<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 定时刷 B站想准点就得要精确闹钟；拿不到会退化成普通闹钟，不会崩 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 手表特性声明为可选：同一份 APK 既能装在手表，也能装在手机上调试 -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".DshWatchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshWatch"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.DshWatch"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 流式生成期间保持连接；手表锁屏后进程不被立即回收 -->
        <service
            android:name=".service.StreamingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- QQ 通道：常驻 WebSocket。和 StreamingService 分开，因为它是长期在线的，
             不是「等一次生成」；两者的通知语义也不一样 -->
        <service
            android:name=".service.QqService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 工作空间产物导出：只暴露 files/workspace/，见 res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- agent 的 set_alarm 工具：闹钟到点后由本接收器发通知 + 振动 -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.dshwatch.action.ALARM_FIRE" />
            </intent-filter>
        </receiver>

        <!-- 每日定时刷 B站：到点起一轮，并在开机后重排（AlarmManager 的闹钟不跨重启） -->
        <receiver
            android:name=".service.BiliDailyReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.dshwatch.action.BILI_DAILY" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Wear OS 2.x/3.x 独立运行（不依赖手机端 App） -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- 声明不支持低功耗常显模式的默认行为 -->
        <meta-data
            android:name="com.google.android.wearable.notificationBridgeMode"
            android:value="no_bridging" />
    </application>

</manifest>
