<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 定时刷 B站想准点就得要精确闹钟；拿不到会退化成普通闹钟，不会崩 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 应用内更新：把下载好的 APK 交给系统安装器。
         这是普通权限，但还受「安装未知应用」的 appop 门控，见 UpdateInstall -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      设备操控期间 App 在后台，AI 每做一步都要等网络往返。系统（尤其国产 ROM）
      在低内存时会把后台进程清掉，表现为「操作到一半，悬浮条和任务一起消失」。
      这个权限只用于弹「是否允许 DSH 不受电池优化限制」的系统对话框，
      不参与任何数据收集；用户拒绝也不影响其它功能。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      内置文件浏览器：读「下载 / 文档 / 图片 / 相机」这些公共目录。

      两档，因为 Android 在这里改过一次规则：
        · API 28–29：READ_EXTERNAL_STORAGE 一个运行时权限就够；
        · API 30+：按路径读公共目录被 FUSE 拦掉，只剩「所有文件访问」这一条路
          （系统文件选择器也要求设备上存在文件管理器，而那正是本功能要兜的底）。

      两者都在运行时申请，都不申请也能用 —— 那时只看得到应用自己的目录。
      存储只读不写，不接受任何上传。
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 手表特性声明为可选：同一份 APK 既能装在手表，也能装在手机上调试 -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      Android 11+ 的包可见性：不声明这段，resolveActivity() 查安装器会返回 null
      （不是没有安装器，是查不到），据此做判断会误报「无法安装」。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <!--
          设备操控要列出「有哪些能打开的 App」。Android 11+ 不声明这一段，
          queryIntentActivities 只会返回自己和系统应用，表现为
          「明明装了微信，模型说找不到」。
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DshWatchApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshWatch"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.DshWatch"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 流式生成期间保持连接；手表锁屏后进程不被立即回收 -->
        <service
            android:name=".service.StreamingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 工作空间产物导出：只暴露 files/workspace/，见 res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- agent 的 set_alarm 工具：闹钟到点后由本接收器发通知 + 振动 -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.dshwatch.action.ALARM_FIRE" />
            </intent-filter>
        </receiver>

        <!-- 每日定时刷 B站：到点起一轮，并在开机后重排（AlarmManager 的闹钟不跨重启） -->
        <receiver
            android:name=".service.BiliDailyReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.dshwatch.action.BILI_DAILY" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          设备操控的无障碍服务。

          exported=true 是系统绑定要求的：只有系统（持 BIND_ACCESSIBILITY_SERVICE
          签名权限）能连上，普通应用绑不了。用户不开这个服务时它完全不运行。

          刻意不声明 uses-permission BIND_ACCESSIBILITY_SERVICE ——
          那是系统签名权限，应用声明了也拿不到，只在 service 上用
          android:permission 限住谁能绑定。
        -->
        <service
            android:name=".service.DeviceA11yService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/device_accessibility" />
        </service>

        <!-- Wear OS 2.x/3.x 独立运行（不依赖手机端 App） -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- 声明不支持低功耗常显模式的默认行为 -->
        <meta-data
            android:name="com.google.android.wearable.notificationBridgeMode"
            android:value="no_bridging" />
    </application>

</manifest>
