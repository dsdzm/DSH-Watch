<?xml version="1.0" encoding="utf-8"?>
<!--
  导出工作空间产物时用到的 FileProvider 路径。

  ⚠️ 这里必须把**内部**和**外部私有**两个位置都列上。
  因为「文件存放位置」默认就是外部私有目录（用户能用数据线直接拷），
  而 FileProvider 的 <files-path> 只映射内部 files/ ——
  少一个 external-files-path，切到外部目录后所有导出都会抛
  IllegalArgumentException: Failed to find configured root，且被上层 runCatching 吞掉，
  表现就是「点导出什么都没发生」。

  cache/share 是最后一道兜底：文件不在上面任何一处时（例如用户手工换过位置），
  先复制一份到缓存目录再分享，保证导出永远有结果。

  这三个目录都在应用私有沙盒内，API Key 之类的敏感数据不在其中。
-->
<paths>
    <files-path name="workspace" path="workspace/" />
    <external-files-path name="workspace_ext" path="workspace/" />
    <cache-path name="share_cache" path="share/" />
    <!--
      拍照的落地目录。

      手机版对话页的「拍照」走系统相机（ACTION_IMAGE_CAPTURE），相机 App 需要一个
      **可写的 uri** 来存原图 —— 它拿到的是我们通过 FileProvider 发出的
      content://，映射的就是这条 cache/camera。少这一行，
      `getUriForFile` 抛 IllegalArgumentException: Failed to find configured root，
      表现是「点拍照什么都没发生」。
    -->
    <cache-path name="camera" path="camera/" />
    <!-- 应用内更新下载的 APK：装完就删，放缓存而不是 files，别长期占用用户数据区 -->
    <cache-path name="apk" path="apk/" />
    <!--
      「保存安装包到本地」存下的两份。

      少了这两条，`UpdateInstall` 交给系统安装器时会抛
      IllegalArgumentException: Failed to find configured root —— 和上面 workspace
      那次是同一个坑，只是换了个目录。表现同样是「点了没反应」，且被 runCatching 吞掉。

      · apk_ext：应用外部目录 <包名>/files/Download/DSH-Watch/（无需任何权限）
      · apk_public：公共「下载」目录 Download/DSH-Watch/（<external-path> 映射的是
        外部存储根，只有本应用确实读得到时才会走到这里，见 UpdateStore.findSaved）
      两者都不是敏感数据：就是用户自己点的那个安装包。
    -->
    <external-files-path name="apk_ext" path="Download/DSH-Watch/" />
    <external-path name="apk_public" path="Download/DSH-Watch/" />
</paths>
